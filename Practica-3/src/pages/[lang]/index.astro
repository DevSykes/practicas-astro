---
import "../../styles/global.css";
import IntroSection from "../../components/sections/1-intro.astro";
import VideoSection from "../../components/sections/2-video.astro";
import EndSection from "../../components/sections/3-end.astro";

export async function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ISDIN - Distribuidores Autorizados</title>
  </head>
  <body class="min-h-screen bg-white">
    <IntroSection lang={lang} />
    <VideoSection lang={lang} />
    <EndSection lang={lang} />
  </body>
</html>
