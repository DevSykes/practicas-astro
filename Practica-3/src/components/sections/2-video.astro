---
const { lang } = Astro.props;

const sectionStyle =
  "w-full py-16 px-8 md:px-[140px] bg-white flex flex-col items-center";
const titleStyle =
  "font-raleway font-semibold text-[40px] leading-[48px] text-[#2D2831] mb-3 text-center";
const subtitleStyle =
  "font-mulish font-normal text-[16px] leading-[24px] text-[#414141] mb-8 text-center";
---

<section class={sectionStyle}>
  <h2 class={titleStyle}>
    {
      lang === "es"
        ? "Un paso más de tu mano hacia la excelencia"
        : "A step further hand in hand towards excellence"
    }
  </h2>

  <p class={subtitleStyle}>
    {
      lang === "es"
        ? "Te presentamos la nueva red de distribuidores autorizados ISDIN."
        : "We present you the new network of ISDIN authorized distributors."
    }
  </p>

  <!-- Contenedor para video -->
  <div
    class="w-full max-w-3xl aspect-video bg-gray-200 rounded-lg flex items-center justify-center"
  >
    <p class="text-gray-500 font-mulish">
      {lang === "es" ? "Video de prueba" : "Video test"}
    </p>
  </div>
</section>
